###############################################################################
# Xế Hộ 24/7 - Đà Nẵng - Nginx Security Configuration
# Domain: xeho247.vn
# Server: 103.82.132.130
# Author: Nguyen Trieu
# Date: 2026-01-31
###############################################################################

# HTTP to HTTPS redirect
server {
    listen 80;
    listen [::]:80;
    server_name xeho247.vn www.xeho247.vn;
    
    # Redirect all HTTP to HTTPS
    return 301 https://xeho247.vn$request_uri;
}

# WWW to non-WWW redirect
server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name www.xeho247.vn;
    
    # SSL Certificates (managed by Certbot)
    ssl_certificate /etc/letsencrypt/live/xeho247.vn/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/xeho247.vn/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;
    
    # Redirect www to non-www
    return 301 https://xeho247.vn$request_uri;
}

# Main HTTPS server block
server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name xeho247.vn;
    
    # Root and index
    root /var/www/webroot/xeho247danang/src/public;
    index index.php index.html index.htm;
    
    # Charset
    charset utf-8;
    
    # Hide Nginx version
    server_tokens off;
    
    ###############################################################################
    # SSL Configuration (managed by Certbot)
    ###############################################################################
    
    ssl_certificate /etc/letsencrypt/live/xeho247.vn/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/xeho247.vn/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;
    
    # OCSP Stapling (non-conflicting with Certbot)
    ssl_stapling on;
    ssl_stapling_verify on;
    resolver 8.8.8.8 8.8.4.4 valid=300s;
    resolver_timeout 5s;
    
    ###############################################################################
    # Security Headers
    ###############################################################################
    
    # HSTS (HTTP Strict Transport Security) - 6 months
    add_header Strict-Transport-Security "max-age=15552000; includeSubDomains; preload" always;
    
    # X-Frame-Options - Prevent clickjacking
    add_header X-Frame-Options "SAMEORIGIN" always;
    
    # X-Content-Type-Options - Prevent MIME sniffing
    add_header X-Content-Type-Options "nosniff" always;
    
    # X-XSS-Protection - Enable XSS filter
    add_header X-XSS-Protection "1; mode=block" always;
    
    # Referrer Policy
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    
    # Permissions Policy (formerly Feature Policy)
    add_header Permissions-Policy "geolocation=(self), microphone=(), camera=(), payment=(self)" always;
    
    # Content Security Policy (CSP)
    add_header Content-Security-Policy "default-src 'self' https:; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://www.googletagmanager.com https://www.google-analytics.com https://cdn.jsdelivr.net https://cdn.tailwindcss.com https://maps.googleapis.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdn.jsdelivr.net https://cdnjs.cloudflare.com; font-src 'self' https://fonts.gstatic.com https://cdnjs.cloudflare.com; img-src 'self' data: https: blob:; connect-src 'self' https://www.google-analytics.com https://maps.googleapis.com https://cdn.jsdelivr.net; frame-src 'self' https://www.youtube.com https://www.facebook.com; object-src 'none'; base-uri 'self'; form-action 'self';" always;
    
    ###############################################################################
    # Logging
    ###############################################################################
    
    access_log /var/log/nginx/xeho247_access.log;
    error_log /var/log/nginx/xeho247_error.log;
    
    ###############################################################################
    # File Upload Limits
    ###############################################################################
    
    client_max_body_size 20M;
    client_body_buffer_size 128k;
    
    ###############################################################################
    # Gzip Compression
    ###############################################################################
    
    gzip on;
    gzip_vary on;
    gzip_proxied any;
    gzip_comp_level 6;
    gzip_types text/plain text/css text/xml text/javascript application/json application/javascript application/xml+rss application/rss+xml font/truetype font/opentype application/vnd.ms-fontobject image/svg+xml;
    gzip_disable "msie6";
    gzip_min_length 256;
    
    ###############################################################################
    # Security - Block Access to Sensitive Files
    ###############################################################################
    
    # Deny access to hidden files (starting with .)
    location ~ /\. {
        deny all;
        access_log off;
        log_not_found off;
    }
    
    # Deny access to sensitive files
    location ~* \.(env|git|gitignore|gitattributes|log|sql|sqlite|bak|backup|old|swp|swo|DS_Store)$ {
        deny all;
        access_log off;
        log_not_found off;
    }
    
    # Deny access to composer files
    location ~* (composer\.(json|lock)|package(-lock)?\.json|yarn\.lock)$ {
        deny all;
    }
    
    # Block access to vendor directories
    location ~ ^/(vendor|node_modules|storage|bootstrap/cache) {
        deny all;
    }
    
    ###############################################################################
    # Rate Limiting
    ###############################################################################
    
    # Rate limit zone (defined in nginx.conf or http block)
    # limit_req_zone $binary_remote_addr zone=booking:10m rate=3r/m;
    # limit_req_zone $binary_remote_addr zone=general:10m rate=10r/s;
    
    # Apply rate limit to booking endpoint
    location ~* ^/(api/)?booking {
        # limit_req zone=booking burst=5 nodelay;
        try_files $uri $uri/ /index.php?$query_string;
    }
    
    ###############################################################################
    # Laravel - Main location block
    ###############################################################################
    
    location / {
        try_files $uri $uri/ /index.php?$query_string;
    }
    
    ###############################################################################
    # PHP-FPM Configuration
    ###############################################################################
    
    location ~ \.php$ {
        # Security: Don't execute PHP files that don't exist
        try_files $uri =404;
        
        fastcgi_split_path_info ^(.+\.php)(/.+)$;
        fastcgi_pass unix:/run/php/php8.4-fpm.sock;
        fastcgi_index index.php;
        fastcgi_param SCRIPT_FILENAME $realpath_root$fastcgi_script_name;
        fastcgi_param PATH_INFO $fastcgi_path_info;
        include fastcgi_params;
        
        # PHP-FPM tuning
        fastcgi_buffer_size 128k;
        fastcgi_buffers 256 4k;
        fastcgi_busy_buffers_size 256k;
        fastcgi_temp_file_write_size 256k;
        fastcgi_read_timeout 300;
        fastcgi_connect_timeout 300;
        fastcgi_send_timeout 300;
        
        # Security headers for PHP responses
        fastcgi_hide_header X-Powered-By;
    }
    
    ###############################################################################
    # Static Files Caching
    ###############################################################################
    
    # Cache static assets
    location ~* \.(jpg|jpeg|png|gif|ico|css|js|svg|woff|woff2|ttf|eot|otf|webp|avif)$ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        access_log off;
        log_not_found off;
        
        # Security headers (inherit from server block)
        add_header X-Content-Type-Options "nosniff" always;
    }
    
    # Favicon caching
    location = /favicon.ico {
        access_log off;
        log_not_found off;
        expires 1y;
    }
    
    # Robots.txt
    location = /robots.txt {
        access_log off;
        log_not_found off;
        allow all;
    }
    
    # Sitemap
    location = /sitemap.xml {
        access_log off;
        log_not_found off;
        allow all;
    }
    
    ###############################################################################
    # Error Pages
    ###############################################################################
    
    error_page 404 /index.php;
    error_page 500 502 503 504 /50x.html;
    
    location = /50x.html {
        root /usr/share/nginx/html;
        internal;
    }
}
